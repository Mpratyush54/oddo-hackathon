# Copy to .env locally. Never put provider secrets in VITE_ variables.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_DAILY_LIMIT=30

# Email verification. Use a verified sender in your email provider.
# Server-only credentials; never use VITE_ variables for these values.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Razorpay TEST mode only. Do not use live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional SendGrid API alternative: leave SMTP_HOST blank to use it.
SENDGRID_API_KEY=
EMAIL_FROM=
# Public website origin used in verification links. Production must use HTTPS.
EMAIL_VERIFICATION_ORIGIN=http://127.0.0.1:5174

# Meta WhatsApp TEST phone-number credentials.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
# Use the Graph version shown in your Meta API setup example.
META_GRAPH_VERSION=v25.0
# Comma-separated verified test phone numbers, country code included.
META_TEST_RECIPIENTS=
META_WHATSAPP_TEMPLATE=hello_world
META_TEMPLATE_LANGUAGE=en_US
META_TEMPLATE_PARAMETER_COUNT=0
# Optional comma-separated parameter fields: name,title,body,url.
# Three body parameters default to name,title,body. Zero parameters send static text only.
META_TEMPLATE_FIELDS=
# Meta app secret is required to authenticate delivery webhooks.
META_APP_SECRET=
# AWS deployment generates a token if omitted. Copy its value from Secrets Manager into Meta setup.
META_WEBHOOK_VERIFY_TOKEN=
# Generate once with node scripts/setup-browser-push.js; never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
API_PORT=3001
JWT_SECRET=
# Optional for the full backend; AWS generates and stores its signing secret automatically.
APP_ORIGIN=http://127.0.0.1:5174,http://localhost:5174

# Browser API URL only; no secrets. Local requests use Vite's /api proxy.
VITE_API_URL=/api
VITE_BACKEND_MODE=aws
