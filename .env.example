# Copy to .env locally. Never put provider secrets in VITE_ variables.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_DAILY_LIMIT=30

# Meta WhatsApp TEST phone-number credentials.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
# Use the Graph version shown in your Meta API setup example.
META_GRAPH_VERSION=v25.0
# Comma-separated verified test phone numbers, country code included.
META_TEST_RECIPIENTS=
META_WHATSAPP_TEMPLATE=hello_world
META_TEMPLATE_LANGUAGE=en_US
META_TEMPLATE_PARAMETER_COUNT=0
# Meta app secret is required to authenticate delivery webhooks.
META_APP_SECRET=
# AWS deployment generates a token if omitted. Copy its value from Secrets Manager into Meta setup.
META_WEBHOOK_VERIFY_TOKEN=
API_PORT=3001
JWT_SECRET=
# Optional for the full backend; AWS generates and stores its signing secret automatically.
APP_ORIGIN=http://127.0.0.1:5174,http://localhost:5174

# Browser API URL only; no secrets. Local requests use Vite's /api proxy.
VITE_API_URL=/api
VITE_BACKEND_MODE=aws
