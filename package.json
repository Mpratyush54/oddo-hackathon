{
  "name": "skyline-student-association",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:demo": "node scripts/dev.js --demo",
    "dev:ui": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "dev:api": "node backend/demo/api.js",
    "test:api": "node --test backend/tests/**/*.test.js",
    "dev:backend": "node backend/src/entrypoints/local.js",
    "deploy:aws": "node scripts/deploy-aws.js",
    "deploy:aws:code": "node scripts/deploy-existing.js",
    "build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1",
    "format": "prettier --write frontend backend shared scripts infra docs *.json *.md",
    "format:check": "prettier --check frontend backend shared scripts infra docs *.json *.md",
    "test": "npm run test:api && node --test scripts/event-utils.test.js && npm run db:schema:check && npm run db:validate",
    "db:schema": "node scripts/generate-db-schema.js",
    "db:schema:check": "node scripts/generate-db-schema.js --check",
    "db:validate": "node scripts/validate-database.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@aws-sdk/s3-presigned-post": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@codegenie/serverless-express": "^4.17.1",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
