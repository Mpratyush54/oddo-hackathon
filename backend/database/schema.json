        "color": {
          "$ref": "#/$defs/__schema8"
        },
        "image": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "price",
        "memberPrice",
        "stock"
      ],
      "additionalProperties": false
