        },
        "receiptData": {
          "$ref": "#/$defs/__schema8"
        },
        "eventId": {
          "$ref": "#/$defs/__schema0"
        },
        "createdBy": {
          "$ref": "#/$defs/__schema0"
        },
        "reviewedBy": {
          "$ref": "#/$defs/__schema0"
        },
