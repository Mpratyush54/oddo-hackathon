        },
        "sold": {
          "$ref": "#/$defs/__schema3"
        },
        "price": {
          "$ref": "#/$defs/__schema10"
        },
        "memberPrice": {
          "$ref": "#/$defs/__schema10"
        },
        "venue": {
          "$ref": "#/$defs/__schema8"
        },
        "category": {
          "$ref": "#/$defs/__schema8"
        },
        "description": {
          "$ref": "#/$defs/__schema8"
        },
        "image": {
          "$ref": "#/$defs/__schema8"
        },
        "budget": {
          "$ref": "#/$defs/__schema10"
        },
        "gallery": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "recap": {
          "$ref": "#/$defs/__schema8"
        },
        "endDate": {
          "$ref": "#/$defs/__schema9"
        },
        "endTime": {
          "$ref": "#/$defs/__schema12"
        }
      },
      "required": [
        "id",
        "title",
        "date",
        "time",
        "capacity",
        "sold",
        "price",
        "memberPrice"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "$ref": "#/$defs/__schema8"
        },
        "type": {
          "$ref": "#/$defs/__schema8"
        },
        "price": {
          "$ref": "#/$defs/__schema10"
        },
        "memberPrice": {
          "$ref": "#/$defs/__schema10"
        },
        "stock": {
          "type": "object",
