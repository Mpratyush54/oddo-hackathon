        "size": {
          "$ref": "#/$defs/__schema8"
        },
        "amount": {
          "$ref": "#/$defs/__schema10"
        },
        "date": {
          "$ref": "#/$defs/__schema9"
        },
        "promoCode": {
          "$ref": "#/$defs/__schema8"
