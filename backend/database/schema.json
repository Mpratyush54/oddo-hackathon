{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/accountRecord"
    },
    {
      "$ref": "#/$defs/profileRecord"
    },
    {
      "$ref": "#/$defs/accessRecord"
    },
    {
      "$ref": "#/$defs/sessionRecord"
    },
    {
      "$ref": "#/$defs/refreshRecord"
    },
    {
      "$ref": "#/$defs/stateRecord"
    },
    {
      "$ref": "#/$defs/auditRecord"
    },
    {
      "$ref": "#/$defs/deliveryRecord"
    },
    {
      "$ref": "#/$defs/requestRecord"
    },
    {
      "$ref": "#/$defs/counterRecord"
    },
    {
      "$ref": "#/$defs/messageMappingRecord"
    },
    {
      "$ref": "#/$defs/messageStatusRecord"
    }
  ],
  "$defs": {
    "accountRecord": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "minLength": 9,
          "maxLength": 250,
          "format": "starts_with",
          "pattern": "^ACCOUNT#.*",
          "$ref": "#/$defs/__schema0"
        },
        "sk": {
          "type": "string",
          "const": "ACCOUNT"
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "passwordHash": {
          "type": "string"
        }
      },
      "required": [
        "pk",
        "sk",
        "id",
        "passwordHash"
      ],
      "additionalProperties": false
    },
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "__schema1": {
      "type": "number",
      "const": 1
    },
    "profileRecord": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "minLength": 6,
          "maxLength": 250,
          "format": "starts_with",
          "pattern": "^USER#.*",
          "$ref": "#/$defs/__schema0"
        },
        "sk": {
          "type": "string",
          "const": "PROFILE"
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "$ref": "#/$defs/__schema2"
        },
        "emailVerified": {
          "type": "boolean"
        },
        "sessionVersion": {
          "minimum": 1,
          "$ref": "#/$defs/__schema3"
        },
        "createdAt": {
          "$ref": "#/$defs/__schema4"
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "required": [
        "pk",
        "sk",
        "id",
        "name",
        "email",
        "emailVerified",
        "sessionVersion",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "maxLength": 254,
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "accessRecord": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "minLength": 6,
          "maxLength": 250,
          "format": "starts_with",
          "pattern": "^USER#.*",
          "$ref": "#/$defs/__schema0"
        },
        "sk": {
          "type": "string",
          "minLength": 8,
          "maxLength": 250,
          "format": "starts_with",
          "pattern": "^ACCESS#.*",
          "$ref": "#/$defs/__schema0"
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "clubId": {
          "$ref": "#/$defs/__schema0"
        },
        "role": {
          "type": "string",
          "enum": [
            "member",
            "organizer",
            "treasurer",
            "admin",
            "college"
          ]
        },
        "collegeId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "pk",
        "sk",
        "clubId",
        "role"
      ],
      "additionalProperties": false
    },
    "sessionRecord": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "minLength": 9,
          "maxLength": 250,
          "format": "starts_with",
          "pattern": "^SESSION#.*",
          "$ref": "#/$defs/__schema0"
        },
        "sk": {
          "type": "string",
          "const": "SESSION"
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "userId": {
          "$ref": "#/$defs/__schema0"
        },
        "sessionVersion": {
          "minimum": 1,
          "$ref": "#/$defs/__schema3"
        },
        "csrfToken": {
          "$ref": "#/$defs/__schema5"
        },
        "revoked": {
          "type": "boolean"
        },
        "expiresAt": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "pk",
        "sk",
        "userId",
        "sessionVersion",
        "csrfToken",
        "revoked",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "format": "sha256_hex",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "__schema6": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "refreshRecord": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "minLength": 9,
          "maxLength": 250,
          "format": "starts_with",
          "pattern": "^REFRESH#.*",
          "$ref": "#/$defs/__schema0"
        },
        "sk": {
          "type": "string",
          "const": "REFRESH"
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "userId": {
          "$ref": "#/$defs/__schema0"
        },
        "sessionId": {
          "$ref": "#/$defs/__schema0"
        },
        "revoked": {
          "type": "boolean"
        },
        "expiresAt": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "pk",
        "sk",
        "userId",
        "sessionId",
        "revoked",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "stateRecord": {
      "type": "object",
      "properties": {
        "pk": {
          "$ref": "#/$defs/__schema7"
        },
        "sk": {
          "type": "string",
          "const": "STATE"
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "version": {
          "minimum": 1,
          "$ref": "#/$defs/__schema3"
        },
        "data": {
          "$ref": "#/$defs/clubData"
        }
      },
      "required": [
        "pk",
        "sk",
        "version",
        "data"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string"
    },
    "clubData": {
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/product"
          }
        },
        "tickets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ticket"
          }
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/order"
          }
        },
        "transactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transaction"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "announcements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/announcement"
          }
        },
        "notifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notification"
          }
        },
        "deliveries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivery"
          }
        },
        "audit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audit"
          }
        },
        "waitlist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waitlist"
          }
        },
        "pointLedger": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "promos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/promo"
          }
        },
        "eventReviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "profile": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/__schema8"
            },
            "email": {
              "$ref": "#/$defs/__schema8"
            },
            "role": {
              "$ref": "#/$defs/__schema8"
            }
          },
          "required": [
            "name",
            "email",
            "role"
          ]
        },
        "preferences": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": [
        "members",
        "events",
        "products",
        "tickets",
        "orders",
        "transactions",
        "tasks",
        "announcements",
        "notifications",
        "deliveries",
        "audit",
        "waitlist",
        "pointLedger",
        "promos"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "userId": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "$ref": "#/$defs/__schema8"
        },
        "email": {
          "$ref": "#/$defs/__schema2"
        },
        "course": {
          "$ref": "#/$defs/__schema8"
        },
        "status": {
          "type": "string",
          "enum": [
            "Active",
            "Pending",
            "Expiring",
            "Expired"
          ]
        },
        "joined": {
          "$ref": "#/$defs/__schema9"
        },
        "expires": {
          "$ref": "#/$defs/__schema9"
        },
        "role": {
          "$ref": "#/$defs/__schema8"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 9,
              "format": "e164",
              "pattern": "^\\+[1-9]\\d{6,14}$"
            },
            {
              "type": "string",
              "const": ""
            }
          ]
        },
        "whatsappOptIn": {
          "type": "boolean"
        },
        "consentUpdatedAt": {
          "$ref": "#/$defs/__schema4"
        },
        "participationPoints": {
          "$ref": "#/$defs/__schema10"
        },
        "volunteerPoints": {
          "$ref": "#/$defs/__schema10"
        },
        "contributionPoints": {
          "$ref": "#/$defs/__schema10"
        },
        "preferences": {
          "$ref": "#/$defs/__schema11"
        },
        "readNotificationIds": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "duesWaived": {
          "type": "boolean"
        },
        "enrollmentSource": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "course",
        "status",
        "joined",
        "expires",
        "role"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "maxLength": 10000
    },
    "__schema9": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "__schema10": {
      "type": "number",
      "minimum": 0
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "email": {
          "type": "boolean"
        },
        "renewals": {
          "type": "boolean"
        },
        "weekly": {
          "type": "boolean"
        }
      },
      "required": [
        "email",
        "renewals",
        "weekly"
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
